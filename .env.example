# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian

# --- Auth (Phase 2) ---
JWT_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only
PII_ENCRYPTION_KEY=change-me-dev-only

# --- LLM providers (Phase 4) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PRIMARY=groq
LLM_DAILY_REQUEST_BUDGET_GROQ=900
LLM_DAILY_REQUEST_BUDGET_GEMINI=1400

# --- Retrieval (Phase 3) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Voice (Phase 6) ---
STT_MODEL=small.en
TTS_VOICE=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
