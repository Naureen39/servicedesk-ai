# Copy to infra/.env and fill in before `make up`. docker-compose.yml reads this file
# automatically because it lives next to it (compose's project-directory convention).

# Public hostname Caddy requests a real HTTPS certificate for. Leave as localhost for a local
# or LAN demo (Caddy then serves a locally-trusted self-signed cert instead).
DOMAIN=localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meridian

# Generate real random values for a real deployment, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
PII_ENCRYPTION_KEY=change-me

# Free-tier keys (Section 3.2): Groq console and Google AI Studio. Both optional -- the
# assistant degrades to deterministic flows and human escalation without them (see
# backend/tests/test_scripted_conversations.py's provider-outage scenarios).
GROQ_API_KEY=
GEMINI_API_KEY=
